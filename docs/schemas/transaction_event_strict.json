{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Evento de Transação - Estrito",
  "type": "object",
  "properties": {
    "transaction_id": { "type": "string", "pattern": "^[0-9a-fA-F-]{36}$" },
    "account_id": { "type": "string", "minLength": 1, "maxLength": 20 },
    "amount_cents": { "type": "integer", "minimum": -9999999999999, "maximum": 9999999999999 },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$", "maxLength": 3 },
    "processed_at": { "type": "string", "format": "date-time" },
    "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 64 },
    "metadata": { "type": "object" }
  },
  "required": ["transaction_id","account_id","amount_cents","currency","processed_at","idempotency_key"],
  "additionalProperties": false
}
